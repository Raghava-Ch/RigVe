{
  "name": "rigve",
  "displayName": "rigve",
  "description": "Source code visualization tool",
  "version": "2.0.0",
  "publisher": "RigVe-tools",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raghava-Ch/RigVe.git"
  },
  "homepage": "https://raghava-ch.github.io/rigve-tool/",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "RigVe.nsDiagram",
        "title": "Open NS Diagram",
        "category": "RigVe"
      },
      {
        "command": "RigVe.cfgDiagram",
        "title": "Open CFG Diagram",
        "category": "RigVe"
      }
    ],
    "configuration": {
      "title": "Rigve",
      "properties": {
        "RigVe.serverLocation": {
          "type": "string",
          "default": "**/",
          "description": "Provide rigve server location"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "RigVe.nsDiagram",
          "when": "resourceLangId == c || resourceLangId == java",
          "group": "Vnavigation"
        },
        {
          "command": "RigVe.cfgDiagram",
          "when": "resourceLangId == java",
          "group": "Vnavigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.10",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "9.19.0",
    "glob": "11.0.1",
    "mocha": "11.1.0",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.24.1"
  }
}
