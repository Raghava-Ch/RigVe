{
  "name": "rigve",
  "displayName": "rigve",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "RigVe.nsDiagram",
        "title": "Open NS Diagram",
        "category": "RigVe"
      }
    ],
    "configuration": {
      "title": "RigVe",
      "properties": {
        "RigVe.serverLocation": {
          "type": "string",
          "default": "**/",
          "description": "Provide rigve server location"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "RigVe.nsDiagram",
          "when": "resourceLangId == c || resourceLangId == java",
          "group": "Vnavigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "9.17.0",
    "glob": "11.0.0",
    "mocha": "^10.2.0",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "node-fetch": "^3.3.2",
    "zod": "^3.24.1"
  }
}